# Email verification (нужно одно из двух)
# Вариант A: Resend https://resend.com
# RESEND_API_KEY=re_xxx
# RESEND_FROM=StoryWeaver <onboarding@ваш-домен.com>
# Вариант B: SMTP (Yandex / Mailgun / любой)
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=noreply@ваш-домен.ru
# SMTP_PASS=пароль_приложения
# SMTP_FROM=StoryWeaver <noreply@ваш-домен.ru>

# Payment link (USD). Placeholders: {orderId} {email} {amount} {currency} {plan}
# PAYMENT_URL=https://pay.example.com/?order={orderId}&amount={amount}&currency={currency}
